			<munit-tools:assert-equals doc:name="Assert Error Type FILE:ARCHIVE_COLLISION" actual="#[payload.errorType]" expected="#['FILE:ARCHIVE_COLLISION']" />
			<munit-tools:assert-that doc:name="Assert Archive File Present" expression="#[payload.archiveFile]" is="#[MunitTools::notNullValue()]" />
			
			<!-- Master control pointer must NEVER be advanced on archive collision -->
			<munit-tools:verify-call processor="db:update" times="0" doc:name="Verify Control Timeline NOT Advanced">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute whereValue="Update Compliance Control Table" attributeName="doc:name" />
				</munit-tools:with-attributes>
			</munit-tools:verify-call>

			<!-- Email notification must NOT be dispatched on archive collision -->
			<munit-tools:verify-call processor="email:send" times="0" doc:name="Verify Email NOT Dispatched" />

			<!-- Database audit record must be updated for REPORT_GENERATED and FAILED states -->
			<munit-tools:verify-call processor="db:update" times="2" doc:name="Verify Audit Update Called for FAILED">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute whereValue="Update Run Audit Status" attributeName="doc:name" />
				</munit-tools:with-attributes>
			</munit-tools:verify-call>
		</munit:validation>
	</munit:test>

	<!-- Test 7: Repeated Requests for Same Reporting Period Generate Unique Archive Filenames -->
	<munit:test name="test-compliance-orchestrator-repeated-requests-unique-archive-filenames" doc:id="test-007" description="Verify repeated runs for the exact same reporting period generate unique, collision-free archive filenames">
		<munit:behavior>
			<!-- Mock Database Control Record -->
			<munit-tools:mock-when processor="db:select" doc:name="Mock Control Select">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute whereValue="Query Compliance Control Table" attributeName="doc:name" />
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[[{ control_id: 1, entity_code: 'ENT0091', report_type: 'STR', last_success_period_end: '2026-09-10 23:59:59', current_sequence_number: 0 }]]" mediaType="application/java" />
					<munit-tools:variables>
						<munit-tools:variable key="controlRecord" value="#[[{ control_id: 1, entity_code: 'ENT0091', report_type: 'STR', last_success_period_end: '2026-09-10 23:59:59', current_sequence_number: 0 }]]" mediaType="application/java" />
					</munit-tools:variables>
				</munit-tools:then-return>
			</munit-tools:mock-when>

			<munit-tools:mock-when processor="db:insert" doc:name="Mock Audit Insert">
				<munit-tools:then-return><munit-tools:payload value="#[1]" /></munit-tools:then-return>
			</munit-tools:mock-when>

			<munit-tools:mock-when processor="db:select" doc:name="Mock Streamed Extraction">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute whereValue="Streamed Extraction Select" attributeName="doc:name" />
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:variables><munit-tools:variable key="extractedRecords" value="#[[]]" mediaType="application/java" /></munit-tools:variables>
				</munit-tools:then-return>
			</munit-tools:mock-when>

			<munit-tools:mock-when processor="db:select" doc:name="Mock Zero Aggregate">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute whereValue="Aggregate Select" attributeName="doc:name" />
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:variables><munit-tools:variable key="aggregateTotals" value="#[[{ total_records: 0, total_amount: 0.00, total_customers: 0 }]]" mediaType="application/java" /></munit-tools:variables>
				</munit-tools:then-return>
			</munit-tools:mock-when>

			<munit-tools:mock-when processor="db:select" doc:name="Mock Historical Select">
				<munit-tools:then-return>
					<munit-tools:variables><munit-tools:variable key="historicalRuns" value="#[[]]" mediaType="application/java" /></munit-tools:variables>
				</munit-tools:then-return>
			</munit-tools:mock-when>

			<munit-tools:mock-when processor="file:write" doc:name="Mock File Writes"><munit-tools:then-return><munit-tools:payload value="#['OK']" /></munit-tools:then-return></munit-tools:mock-when>
			<munit-tools:mock-when processor="email:send" doc:name="Mock Email Send"><munit-tools:then-return><munit-tools:payload value="#['SENT']" /></munit-tools:then-return></munit-tools:mock-when>
			<munit-tools:mock-when processor="db:update" doc:name="Mock DB Updates"><munit-tools:then-return><munit-tools:payload value="#[1]" /></munit-tools:then-return></munit-tools:mock-when>
		</munit:behavior>

		<munit:execution>
			<!-- First Run for reporting period -->
			<flow-ref name="compliance-orchestrator-flow" doc:name="Execute Run 1" />
			<set-variable value="#[payload.archiveFile]" doc:name="Store Run 1 Archive File" variableName="run1ArchiveFile" />
			<set-variable value="#[payload.summaryFile]" doc:name="Store Run 1 Summary File" variableName="run1SummaryFile" />

			<!-- Second Run for same period -->
			<flow-ref name="compliance-orchestrator-flow" doc:name="Execute Run 2" />
			<set-variable value="#[payload.archiveFile]" doc:name="Store Run 2 Archive File" variableName="run2ArchiveFile" />
			<set-variable value="#[payload.summaryFile]" doc:name="Store Run 2 Summary File" variableName="run2SummaryFile" />
		</munit:execution>

		<munit:validation>
			<!-- Verify both runs succeeded -->
			<munit-tools:assert-equals doc:name="Assert Run 2 Status SUCCESS" actual="#[payload.status]" expected="#['SUCCESS']" />
			
			<!-- Verify both archive filenames contain the expected base components: entity, report type -->
			<munit-tools:assert-that doc:name="Assert Run 1 Has Base Pattern" 
				expression="#[vars.run1ArchiveFile contains 'ENT0091_STR_']" is="#[MunitTools::equalTo(true)]" />
			<munit-tools:assert-that doc:name="Assert Run 2 Has Base Pattern" 
				expression="#[vars.run2ArchiveFile contains 'ENT0091_STR_']" is="#[MunitTools::equalTo(true)]" />
			
			<!-- CRITICAL ASSERTION: The two archive filenames MUST be distinct and unique (no collision!) -->
			<munit-tools:assert-that doc:name="Assert Unique Archive Submission Filenames" 
				expression="#[vars.run1ArchiveFile != vars.run2ArchiveFile]" is="#[MunitTools::equalTo(true)]" />
			<munit-tools:assert-that doc:name="Assert Unique Archive Summary Filenames" 
				expression="#[vars.run1SummaryFile != vars.run2SummaryFile]" is="#[MunitTools::equalTo(true)]" />
		</munit:validation>
	</munit:test>

