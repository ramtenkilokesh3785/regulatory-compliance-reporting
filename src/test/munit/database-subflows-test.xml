				<munit-tools:with-attributes>
					<munit-tools:with-attribute whereValue="Update Flags to REPORTED" attributeName="doc:name" />
				</munit-tools:with-attributes>
			</munit-tools:verify-call>
		</munit:validation>
	</munit:test>

	<!-- Test 14: Reporting Period Control Calculation Advances Sequence for Prior Period Runs -->
	<munit:test name="test-get-reporting-period-control-subflow-advances-past-existing-period-runs" doc:id="test-db-014" description="Verify control period calculation increments sequence past existing period sequence when prior runs exist in compliance_report_runs">
		<munit:behavior>
			<munit-tools:mock-when processor="db:select" doc:name="Mock Control Select With Existing Period Run">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute whereValue="Query Compliance Control Table" attributeName="doc:name" />
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:variables>
						<munit-tools:variable key="controlRecord" value="#[[{ control_id: 1, entity_code: 'ENT0091', report_type: 'STR', last_success_period_end: '2026-09-10 23:59:59', current_sequence_number: 0, max_period_sequence: 1 }]]" mediaType="application/java" />
					</munit-tools:variables>
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>

		<munit:execution>
			<munit:set-event doc:name="Set Event Manual Period">
				<munit:variables>
					<munit:variable key="manualPeriodStart" value="#['2026-09-15 00:00:00']" mediaType="application/java" />
					<munit:variable key="manualPeriodEnd" value="#['2026-09-15 23:59:59']" mediaType="application/java" />
				</munit:variables>
			</munit:set-event>
			<flow-ref name="get-reporting-period-control-subflow" doc:name="Call get-reporting-period-control-subflow" />
		</munit:execution>

		<munit:validation>
			<munit-tools:assert-equals doc:name="Assert Entity Code" actual="#[vars.runContext.entityCode]" expected="#['ENT0091']" />
			<!-- Since max_period_sequence is 1, next sequence must advance to 2 (_002) -->
			<munit-tools:assert-equals doc:name="Assert Sequence Advanced to 2" actual="#[vars.runContext.sequenceNumber]" expected="#[2]" />
			<munit-tools:assert-equals doc:name="Assert Is Revision True" actual="#[vars.runContext.isRevision]" expected="#[true]" />
		</munit:validation>
	</munit:test>

</mule>
